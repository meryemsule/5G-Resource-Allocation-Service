APP_NAME=SAYZEK 5G Resource Allocation API
APP_VERSION=2.0.0
LOG_LEVEL=INFO
LOG_FORMAT=json
PPO_MODEL_PATH=models/ppo_5g_agent.zip
LSTM_MODEL_PATH=models/lstm_traffic_model.pth
MODEL_METADATA_PATH=models/model_metadata.json
TRAFFIC_PREDICTOR_PATH=models/sayzek_traffic_predictor.keras
FAST_PREDICTOR_PATH=models/sayzek_fast_predictor.pkl
RESIDUAL_PPO_MODEL_PATH=models/sayzek_residual_ppo_scheduler.zip
FAST_POLICY_CORRECTION=0.25
GUARD_PEAK_WEIGHT=0.45
GUARD_BURSTINESS_WEIGHT=0.35
GUARD_LOAD_WEIGHT=0.20
GUARD_ALPHA_BASE=0.25
GUARD_ALPHA_RISK_GAIN=0.65
GUARD_HIGH_RISK_SAFETY_FLOOR=0.05
GUARD_DEFAULT_SAFETY_FLOOR=0.02
GUARD_HIGH_RISK_PEAK_THRESHOLD=0.30
GUARD_HIGH_RISK_BURSTINESS_THRESHOLD=0.50
GUARD_DYNAMIC_CAP_HEADROOM=0.12
GUARD_DYNAMIC_CAP_RISK_GAIN=0.20
URLLC_SERVICE_BASE_ADJUSTMENT=0.066
URLLC_SERVICE_RISK_GAIN=0.03
EMBB_SERVICE_ADJUSTMENT=0.075
MMTC_SERVICE_ADJUSTMENT=-0.024
MMTC_SERVICE_MIN_MARGIN=0.015
MMTC_SERVICE_MIN_ALLOCATION=0.01
X_SCALER_PATH=models/x_scaler.pkl
Y_SCALER_PATH=models/y_scaler.pkl
SAYZEK_METADATA_PATH=models/sayzek_model_metadata.json
PACKET_WINDOW_SECONDS=1
TTI_WINDOW_SIZE=10
TTI_DURATION_MS=1
SNIFF_INTERFACE=
SNIFF_FILTER=ip
AUTO_APPLY_ENABLED=false
SIMULATOR_BASE_URL=http://localhost:8080
SIMULATOR_API_TOKEN=
SIMULATOR_VERIFY_SSL=false
REQUEST_TIMEOUT_SECONDS=5
DECISION_LOG_DB_PATH=data/decision_logs.sqlite3
AUTH_ENABLED=false
API_KEYS=
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_SECONDS=3600
JWT_ISSUER=sayzek-api
CORS_ORIGINS=http://localhost:3000,http://localhost:8501
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
QUEUE_MAX_SIZE=1000
QUEUE_WORKER_COUNT=2
